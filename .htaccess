Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^portal/?$ portal/index.php [L,QSA]
</IfModule>

# Block direct access to sensitive data files
<FilesMatch "(staff-credentials\.json|staff-passwords\.txt)">
    Require all denied
</FilesMatch>

# Prevent direct browsing of content/ (docs are served via PHP)
<IfModule mod_alias.c>
    RedirectMatch 403 ^/content/(.*)$
</IfModule>
